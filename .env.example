# =============================================================================
# ARENA - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and will never be committed
#
# This file shows all variables used across all milestones.
# For M1 (local dev), you only need DATABASE_URL and the demo config below.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Required for all milestones)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# -----------------------------------------------------------------------------
# MODE (Required for all milestones)
# -----------------------------------------------------------------------------
NODE_ENV=development
ARENA_MODE=demo
# Options: 
#   - demo: Uses seeded fixture data, no webhooks
#   - live: Receives real webhook events from GitHub/Linear

# -----------------------------------------------------------------------------
# DEMO CONFIG (Used for M1, kept for reference in later milestones)
# -----------------------------------------------------------------------------
ARENA_LABEL=arena:ready
ALLOWED_REPOS=org/frontend,org/api

# -----------------------------------------------------------------------------
# SEEDING (Used for M1 to populate demo data)
# -----------------------------------------------------------------------------
ARENA_SEED_SOURCE=fixtures
# Options: fixtures | linear
SEED_DAYS=30
# How many days back to simulate activity

# -----------------------------------------------------------------------------
# GITHUB INTEGRATION (Add in M2 when enabling GitHub webhooks)
# -----------------------------------------------------------------------------
# GITHUB_WEBHOOK_SECRET=
# Generate with: openssl rand -hex 32
# Used to verify webhook signatures from GitHub

# GITHUB_TOKEN=
# Fine-grained Personal Access Token with:
#   - Repository access: Select repos in ALLOWED_REPOS
#   - Permissions: Pull requests = Read and write
# Used to patch PR bodies and read commit counts

# -----------------------------------------------------------------------------
# LINEAR INTEGRATION (Add in M3 when enabling Linear webhooks)
# -----------------------------------------------------------------------------
# LINEAR_WEBHOOK_SECRET=
# Generate with: openssl rand -hex 32
# Used to verify webhook signatures from Linear

# LINEAR_API_KEY=
# Personal API key from Linear Settings → API
# Starts with: lin_api_...
# Used to post comments and dispatch agents

# AGENTS_CONFIG_JSON=
# JSON array of agent configurations (paste as single line):
# [{"name":"cursor","mode":"linear_mention","handle":"@Cursor"},{"name":"engine","mode":"linear_mention","handle":"@Engine"},{"name":"cyrus","mode":"linear_mention","handle":"@Cyrus"}]

# ARENA_LABEL_ID=
# Optional: Linear label UUID for more precise filtering
# Can be left empty; webhook will filter by ARENA_LABEL name instead
