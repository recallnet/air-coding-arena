#!/usr/bin/env sh
# === PRE-PUSH HOOK ===
# This hook runs before pushing and verifies production build works.
# Validation already ran in pre-commit, so we only verify Next.js build.

echo "🚀 Running pre-push validation..."

# Test production build (Next.js only, no re-validation)
echo "\n🏗️  Testing production build..."
next build || {
  echo "❌ Production build failed. Fix build errors before pushing."
  exit 1
}

echo "\n✅ Production build successful! Safe to push."
