#!/usr/bin/env sh
# === PRE-COMMIT HOOK ===
# This hook runs on every commit and enforces zero-tolerance quality gates.
# Runs full validation suite once (no redundancy).

echo "🔒 Running pre-commit validation..."

# Run complete validation suite
# Includes: type-check (99.9% coverage), lint (zero warnings), tests (90% coverage), format check
npm run validate || {
  echo "❌ Validation failed. All checks must pass before committing."
  echo "   - Type errors: Run 'npm run type-check' for details"
  echo "   - Lint errors: Run 'npm run lint:fix' to attempt auto-fix"
  echo "   - Format errors: Run 'npm run format' to auto-format"
  echo "   - Test failures: Run 'npm run test:watch' to debug"
  exit 1
}

echo "\n✅ All pre-commit checks passed!"
