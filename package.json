{
  "name": "coding-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "// === DEV SCRIPTS ===": "",
    "predev": "lsof -ti:3109 | xargs kill -9 2>/dev/null || true",
    "dev": "next dev -p 3109",
    "start": "next start -p 3109",
    "// === VALIDATION SCRIPTS - DO NOT MODIFY ===": "",
    "type-check": "tsc --noEmit && type-coverage --at-least 100 --strict --ignore-files '**/*.test.ts*' --ignore-files '**/*.config.*' --ignore-files '**/vitest-setup.ts' --ignore-files '.next/**'",
    "type-coverage": "type-coverage --at-least 100 --strict --ignore-files '**/*.test.ts*' --ignore-files '**/*.config.*' --ignore-files '**/vitest-setup.ts' --ignore-files '.next/**'",
    "// === LINT SCRIPTS - ZERO TOLERANCE ===": "",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "// === TEST SCRIPTS - 90% COVERAGE REQUIRED ===": "",
    "test": "vitest run --coverage --coverage.lines=90 --coverage.functions=90 --coverage.branches=90 --coverage.statements=90",
    "test:watch": "vitest --coverage",
    "test:ui": "vitest --ui --coverage",
    "// === FORMAT SCRIPTS ===": "",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "// === VALIDATION GATE - ALL CHECKS ===": "",
    "validate": "npm run type-check && npm run lint && npm run test && npm run format:check",
    "// === BUILD - RUNS VALIDATION FIRST ===": "",
    "build": "npm run validate && next build",
    "// === DOCS GENERATION ===": "",
    "docs": "typedoc",
    "docs:serve": "npm run docs && npx serve docs/api",
    "// === DATABASE SCRIPTS ===": "",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:manual": "tsx scripts/run-manual-migration.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "export:linear": "tsx scripts/export-linear.ts",
    "// === MIGRATION SCRIPTS ===": "",
    "migrate:real-data": "tsx scripts/migrate-to-real-data.ts",
    "fetch:eng320": "tsx scripts/fetch-eng320-details.ts",
    "// === HUSKY SETUP ===": "",
    "prepare": "husky"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "geist": "^1.5.1",
    "lucide-react": "^0.553.0",
    "next": "^15.0.3",
    "postgres": "^3.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.0.3",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.8.6",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.3",
    "@vitest/ui": "^2.1.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.0.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-functional": "^7.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.4.3",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-no-secrets": "^1.0.2",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^2.0.3",
    "eslint-plugin-testing-library": "^6.3.0",
    "eslint-plugin-unicorn": "^56.0.0",
    "eslint-plugin-vitest": "^0.5.4",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.20.6",
    "type-coverage": "^2.29.1",
    "typedoc": "^0.28.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "vitest-mock-extended": "^2.0.2"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  }
}
