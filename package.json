{
  "name": "air-coding-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "// === DEV SCRIPTS ===": "",
    "dev": "next dev -p 3109",
    "start": "next start -p 3109",
    "// === VALIDATION SCRIPTS - DO NOT MODIFY ===": "",
    "type-check": "tsc --noEmit && type-coverage --at-least 99.9 --strict --ignore-files '**/*.test.ts*' --ignore-files '**/*.config.*' --ignore-files '**/vitest-setup.ts' --ignore-files '.next/**' --ignore-files '**/api/linear/**' --ignore-files '**/test-utils/**'",
    "// === LINT SCRIPTS - ZERO TOLERANCE ===": "",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "// === TEST SCRIPTS - 90% COVERAGE REQUIRED ===": "",
    "test": "vitest run --coverage --coverage.lines=90 --coverage.functions=90 --coverage.branches=90 --coverage.statements=90",
    "test:watch": "vitest --coverage",
    "test:ui": "vitest --ui --coverage",
    "// === FORMAT SCRIPTS ===": "",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "// === VALIDATION GATE - ALL CHECKS ===": "",
    "validate": "npm-run-all --parallel --print-label type-check lint test format:check",
    "// === BUILD - NEXT.JS BUILD ONLY ===": "",
    "build": "next build",
    "vercel-build": "npm run db:migrate && npm run db:migrate:manual && next build",
    "// === DOCS GENERATION ===": "",
    "docs": "typedoc",
    "docs:serve": "npm run docs && npx serve docs/api",
    "// === DATABASE SCRIPTS ===": "",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:manual": "tsx scripts/run-manual-migration.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push && npm run db:migrate:manual",
    "db:seed": "tsx scripts/seed.ts",
    "export:linear": "tsx scripts/export-linear.ts",
    "backfill:metadata": "tsx scripts/backfill-metadata.ts",
    "backfill:ratings": "tsx scripts/backfill-agent-ratings.ts",
    "// === HUSKY SETUP ===": "",
    "prepare": "husky"
  },
  "dependencies": {
    "@geist-ui/icons": "^1.0.2",
    "@linear/sdk": "^63.4.0",
    "@octokit/rest": "^22.0.1",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.7.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.553.0",
    "next": "15.5.28",
    "openskill": "^4.1.1",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.28",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "autoprefixer": "^10.6.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-functional": "^7.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "^1.1.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^2.0.4",
    "eslint-plugin-testing-library": "^6.5.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "eslint-plugin-vitest": "^0.5.4",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "type-coverage": "^2.30.4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mermaid": "^1.12.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "vitest-mock-extended": "^2.0.2",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.12",
      "micromatch": "^4.0.8",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
      "postcss": "^8.5.30",
      "@babel/core": "^7.29.6",
      "sharp": "^0.35.5",
      "deepmerge-ts": "^8.0.0",
      "postcss-selector-parser": "^7.1.6",
      "tinypool": "^2.1.2"
    }
  },
  "packageManager": "pnpm@9.15.4"
}
